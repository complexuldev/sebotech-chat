{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FolkChat",
  "version": "1.0.0",
  "identifier": "com.folkchat.desktop",
  "build": { "frontendDist": "dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "FolkChat",
    "shortDescription": "FolkChat",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "languages": ["Romanian", "English"] }
    }
  }
}
