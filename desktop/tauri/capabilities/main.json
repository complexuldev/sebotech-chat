{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The FolkChat site in the main window may call the native helpers.",
  "windows": ["main"],
  "remote": { "urls": ["https://complexuldev.github.io/*"] },
  "permissions": [
    "core:event:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-procs",
    "allow-foreground",
    "allow-ptt-watch",
    "allow-overlay-open",
    "allow-overlay-close",
    "allow-overlay-interactive",
    "allow-set-unread",
    "allow-app-version"
  ]
}
